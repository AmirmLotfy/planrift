{
  "name": "planrift",
  "version": "0.1.0",
  "private": true,
  "description": "PLANRIFT — architecture revision consequence studio. Rehearse a design change, compute its geometric consequences, and document the decision before committing it.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:domain": "vitest run tests/domain",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify:quick": "npm run typecheck && npm run test:domain",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:release": "npm run verify && npm run e2e"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@noble/hashes": "2.4.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "lucide-react": "1.67.0",
    "next": "16.4.5",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "fast-check": "4.10.2",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmirmLotfy/planrift.git"
  },
  "homepage": "https://planrift-omega.vercel.app",
  "bugs": {
    "url": "https://github.com/AmirmLotfy/planrift/issues"
  }
}
